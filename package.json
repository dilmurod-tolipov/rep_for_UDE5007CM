{
  "name": "library-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack Library Management System - UDE5007CM Web Development coursework",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/migrate.js --reset",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed:users",
    "db:seed:users": "node scripts/seed-users.js"
  },
  "keywords": [
    "express",
    "postgresql",
    "library",
    "rest-api"
  ],
  "author": "Dilmurod Tolipov",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
