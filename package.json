{
  "name": "library-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack Library Management System - UDE5007CM Web Development coursework",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/migrate.js --reset",
    "db:seed": "node scripts/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "keywords": [
    "express",
    "postgresql",
    "library",
    "rest-api"
  ],
  "author": "Dilmurod Tolipov",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
