# Server
NODE_ENV=development
PORT=3000

# PostgreSQL connection string
# local: postgresql://postgres:postgres@localhost:5432/library
# Neon:  postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/library

# TLS for the database connection. Required by managed providers such as Neon,
# normally off for a local instance.
PGSSL=false
# Set to true only for a provider that presents a self-signed certificate.
# Leave unset so the server certificate is verified against the system CA store.
PGSSL_NO_VERIFY=false
# Maximum PostgreSQL connections held by the pool
PGPOOL_MAX=10

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h

# Comma separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
